{
  "name": "myplan",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "myplan-db",
      "database_id": "20b52be6-deac-4832-887d-7e6f51c40e7c",
      "migrations_dir": "drizzle"
    }
  ]
}
